# Copy to .env and edit. .env is git-ignored; never commit real values.

NODE_ENV=development

# Native PostgreSQL (no Docker). Two separate logins (Phase 7, docs/phase-7-security-operations.md):
#
# DATABASE_URL is what the RUNNING API uses. It must be the least-privilege runtime role (created by `npm run db:roles`):
# not a superuser, owns nothing, cannot change the schema, cannot update or delete audit history. The API checks this at
# startup and refuses to start in production if it is not true. The API never reads MIGRATION_DATABASE_URL.
DATABASE_URL=postgres://foodloop_runtime:CHANGE_ME@localhost:5432/foodloop
# MIGRATION_DATABASE_URL is the PRIVILEGED login (owner/superuser) used only by operator commands: db:setup, db:migrate,
# db:seed, db:roles, retention. Required in production. In development, if unset, those commands fall back to
# DATABASE_URL with a notice (the old single-credential setup). Keep it out of the API's environment in production.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/foodloop
# Runtime role setup. RUNTIME_DB_PASSWORD (16+ chars) is read only by `npm run db:roles` to create the role or rotate its
# password; remove it afterwards (the password then lives only in DATABASE_URL).
RUNTIME_DB_ROLE=foodloop_runtime
# RUNTIME_DB_PASSWORD=
# How the API reacts to a runtime role with excessive privileges: enforce (default in production, required there) or warn
# (default elsewhere; the warning is repeated on every start).
# DB_PRIVILEGE_CHECK=warn
# Separate database used only by `npm test`, privileged login. Tests DELETE ALL DATA in it and create a throwaway
# least-privilege role in it (random password per run) that the application under test connects as.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/foodloop_test

API_PORT=4000
# Used by the Next.js dev/prod server to proxy /api/* to the API.
API_ORIGIN=http://localhost:4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_COST=12

# Explicit allow-list (comma separated). Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Must be true in production (requires HTTPS).
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
# Reverse-proxy hops in front of the API whose X-Forwarded-For may be trusted for rate limiting (0 = trust none).
# Behind the Next.js rewrite or a load balancer set the real number; otherwise all clients share one IP bucket.
TRUST_PROXY_HOPS=0
# Per-limiter overrides (fixed window, counted per signed-in user, else per IP, in this process's memory).
# Defaults shown: AUTH 60/15 min, UPLOAD 20/10 min, RESCUE_ACTION 120/5 min, INCIDENT 10/15 min, LOCATION 60/1 min.
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
# RATE_LIMIT_RESCUE_ACTION_MAX=120
# RATE_LIMIT_RESCUE_ACTION_WINDOW_SECONDS=300
# RATE_LIMIT_INCIDENT_MAX=10
# RATE_LIMIT_INCIDENT_WINDOW_SECONDS=900
# RATE_LIMIT_LOCATION_MAX=60
# RATE_LIMIT_LOCATION_WINDOW_SECONDS=60

# How often the in-process job marks past-deadline listings EXPIRED (0 disables it;
# reads always filter by deadline, so this only keeps stored statuses tidy).
EXPIRY_INTERVAL_SECONDS=60

# Matching (Phase 4). Travel time is an ESTIMATE from straight-line distance; there is no routing provider.
MATCH_SEARCH_RADIUS_KM=10
MATCH_ROAD_DISTANCE_FACTOR=1.4
MATCH_AVG_SPEED_KMH=25
MATCH_DISPATCH_BUFFER_MINUTES=20
MATCH_TARGET_MARGIN_MINUTES=60
# Score weights (percent); they must add up to 100.
MATCH_WEIGHT_DISTANCE=35
MATCH_WEIGHT_URGENCY=25
MATCH_WEIGHT_QUANTITY=20
MATCH_WEIGHT_NEED=10
MATCH_WEIGHT_RELIABILITY=10
# Reliability for NGOs with no rescue history (none exists yet).
MATCH_NEUTRAL_RELIABILITY=50

# Rescue deadlines (Phase 5). Expiry is enforced on every read/transition, so a delayed timer is harmless.
RESCUE_PROVIDER_CONFIRM_MINUTES=15
RESCUE_PICKUP_EARLY_MINUTES=30
RESCUE_PICKUP_GRACE_MINUTES=30
RESCUE_DELIVERY_CONFIRM_HOURS=12
RESCUE_MAX_CODE_ATTEMPTS=5
# Admin operations board: a stage is DELAYED once this share (1-99) of its allowed time has passed. Inclusive.
OPS_DELAYED_ELAPSED_PERCENT=75

# Escalation waves (spec 3.3 / 8.4). When nobody accepts a listing, who is told widens in controlled steps. Minutes after the
# listing is published (fractions allowed). These defaults are the specification's own example (a "proposed demo policy"),
# i.e. the PILOT profile; they are configuration, not business rules. Must not decrease in this order, and the three NGO
# radii must not shrink. Radii are capped at MATCH_SEARCH_RADIUS_KM. URGENT (<60 min left) listings use the URGENT scale,
# CRITICAL (<30 min) the CRITICAL scale (0 = everything immediately). No step is later than the margin before the deadline.
ESCALATION_ENABLED=true
ESCALATION_WAVE1_MINUTES=3
ESCALATION_WAVE1_RADIUS_KM=3
ESCALATION_WAVE2_MINUTES=15
ESCALATION_WAVE2_RADIUS_KM=6
ESCALATION_RUNNER_MINUTES=25
ESCALATION_RUNNER_RADIUS_KM=6
ESCALATION_WAVE3_MINUTES=35
ESCALATION_WAVE3_RADIUS_KM=10
ESCALATION_ADMIN_MINUTES=45
ESCALATION_BATCH_SIZE=5
ESCALATION_RUNNER_BATCH_SIZE=10
ESCALATION_URGENT_SCALE=0.5
ESCALATION_CRITICAL_SCALE=0
ESCALATION_DEADLINE_MARGIN_MINUTES=5
# How often the worker looks for due steps (0 disables the worker; steps already due at publish still run).
ESCALATION_INTERVAL_SECONDS=30
# DEMO profile (seconds-scale, to watch a listing escalate in half a minute): uncomment these instead of the times above.
# ESCALATION_WAVE1_MINUTES=0.1
# ESCALATION_WAVE2_MINUTES=0.2
# ESCALATION_RUNNER_MINUTES=0.3
# ESCALATION_WAVE3_MINUTES=0.4
# ESCALATION_ADMIN_MINUTES=0.5
# ESCALATION_INTERVAL_SECONDS=3

# Runner logistics (Phase 6).
RESCUE_RUNNER_SEARCH_MINUTES=30
RESCUE_TRANSIT_MINUTES=120
# Load estimate when a listing gives no weight.
RUNNER_KG_PER_SERVING=0.4
RUNNER_LOCATION_MIN_INTERVAL_SECONDS=5
RUNNER_LOCATION_MAX_AGE_MINUTES=10

# Retention (operator command `npm run retention`, dry run by default; `-- --execute` applies). NOTHING is deleted unless a
# period is set here AND --execute is passed. Measured from the day an incident was RESOLVED; open incidents and incidents
# on rescues still in progress are never touched. Minimums: evidence 7 days, incidents 30 days, orphan files 1 hour.
# RETENTION_EVIDENCE_DAYS=       evidence photos (files and rows) of resolved incidents
# RETENTION_INCIDENT_DAYS=       whole resolved incidents (must be >= RETENTION_EVIDENCE_DAYS)
# RETENTION_ORPHAN_FILE_HOURS=   unreferenced files in storage older than this (failed-upload debris)

# Private directory for uploaded verification documents (never served statically).
# Default: <repo>/storage/uploads, which is git-ignored.
# STORAGE_DIR=

# Shared password for the seeded demo accounts. Local development only.
# Min 10 characters with a letter and a number. No default is provided on purpose.
DEMO_PASSWORD=
